# Server
HOST=0.0.0.0
PORT=4310
HUB_PUBLIC_URL=https://hub.example.com

# PostgreSQL
POSTGRES_USER=u3code
POSTGRES_PASSWORD=change-me
POSTGRES_DB=u3code_hub
DATABASE_URL=postgres://u3code:change-me@localhost:5432/u3code_hub

# Security (generate via: openssl rand -hex 32)
HUB_JWT_SECRET=replace-with-32-byte-random-hex
HUB_ENCRYPTION_KEY=replace-with-32-byte-random-hex

# GitHub OAuth & Org Allowlist (comma-separated, empty = allow any GitHub user)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_ORGS=
GITHUB_WEBHOOK_SECRET=

# Optional LLM for AI Cockpit Digest synthesis (any OpenAI-compatible API; falls back deterministically if empty)
HUB_LLM_BASE_URL=https://api.openai.com/v1
HUB_LLM_API_KEY=
HUB_LLM_MODEL=gpt-4.1-mini

# Optional scheduled daily AI digests (comma-separated HH:MM, empty = disabled)
HUB_DIGEST_SCHEDULE_TIMES=09:30,19:00
# Timezone offset in minutes from UTC (e.g. 480 for Asia/Shanghai UTC+8)
HUB_DIGEST_TZ_OFFSET_MINUTES=480

# Local dev convenience (never enable in production)
HUB_ALLOW_LOCAL_DEV_AUTH=false
