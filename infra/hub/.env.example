# --- Core Server ---
PORT=4310
HOST=0.0.0.0
# Public base URL of u3code-hub (use https://hub.yourdomain.com in production)
HUB_PUBLIC_URL=http://127.0.0.1:4310

# --- PostgreSQL (used by docker-compose.yml) ---
POSTGRES_USER=u3code
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=u3code_hub
DATABASE_URL=postgres://u3code:replace-with-strong-db-password@localhost:5432/u3code_hub

# --- Security Secrets (REQUIRED in production: generate with `openssl rand -hex 32`) ---
HUB_JWT_SECRET=replace-with-random-64-hex-chars
HUB_ENCRYPTION_KEY=replace-with-another-random-64-hex-chars

# --- Authentication ---
# Set to "true" ONLY for quick local/LAN trial without GitHub OAuth. Set to "false" in production.
HUB_ALLOW_LOCAL_DEV_AUTH=true
# GitHub OAuth App (Callback URL: ${HUB_PUBLIC_URL}/api/v1/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub orgs allowed to sign in (leave empty to allow any authenticated GitHub user)
ALLOWED_GITHUB_ORGS=

# --- GitHub Integration ---
# Webhook secret configured in GitHub Repo/Org Webhooks (Payload URL: ${HUB_PUBLIC_URL}/webhooks/github)
GITHUB_WEBHOOK_SECRET=
# Optional fine-grained PAT (Pull requests: Read) for Day-1 "Sync PRs" on private repositories
GITHUB_SYNC_TOKEN=

# --- AI Cockpit Digest & Daily Scheduler (OpenAI-compatible API) ---
HUB_LLM_BASE_URL=https://api.openai.com/v1
HUB_LLM_API_KEY=
HUB_LLM_MODEL=gpt-4.1-mini
# Comma-separated daily HH:MM triggers (e.g. "09:30,19:00"). Leave empty to disable scheduled digests.
HUB_DIGEST_SCHEDULE_TIMES=
# Timezone offset from UTC in minutes (e.g. 480 for UTC+8)
HUB_DIGEST_TZ_OFFSET_MINUTES=480

# --- Hub Plugins & Automation ---
# Optional comma-separated ESM plugin module paths or npm package names
HUB_PLUGINS=
# Optional verification token for Lark interactive card gate callbacks (${HUB_PUBLIC_URL}/plugins/lark/callback)
HUB_LARK_VERIFICATION_TOKEN=
# Optional T3 Code Workflow webhook URL (from `t3 workflow hooks`) receiving signed Hub events
HUB_AUTOMATION_WEBHOOK_URL=
HUB_AUTOMATION_WEBHOOK_SECRET=
